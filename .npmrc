# eslint-config-next@16.3.0 depends on eslint-plugin-react@7.x / jsx-a11y@6.x /
# import@2.x, which only declare peer support up to eslint ^9. The project targets
# eslint 10 (unicorn@73 requires >=10.4), so npm cannot auto-resolve those peers.
# Relax peer resolution instead of downgrading the linter (same behaviour as bun).
legacy-peer-deps=true
